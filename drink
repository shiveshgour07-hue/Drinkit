<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Drinkit — beer, wine & spirits delivered</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Fraunces:wght@500;600;700;800&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
  :root {
    --bg: #F6F3EE;
    --surface: #FFFFFF;
    --ink: #241A14;
    --ink-soft: #6B5C50;
    --border: #E7DFD3;
    --wine: #6E1423;
    --wine-deep: #4A0D18;
    --wine-pale: #F4E3E4;
    --amber: #C97A2B;
    --amber-deep: #A8631E;
    --gold: #D9A441;
    --danger: #B23B3B;
    --radius-s: 8px;
    --radius-m: 14px;
    --radius-l: 22px;
    --font-display: 'Fraunces', Georgia, serif;
    --font-body: 'Inter', system-ui, sans-serif;
    box-sizing: border-box;
  }
  :root:not([data-theme="light"]) {
    @media (prefers-color-scheme: dark) {
      --bg: #1A1310;
      --surface: #241A15;
      --ink: #F1E7DE;
      --ink-soft: #B4A392;
      --border: #38291F;
      --wine: #B23349;
      --wine-deep: #E15A6F;
      --wine-pale: #2E1A1E;
      --amber: #E29A4D;
      --gold: #E6BC64;
    }
  }
  :root[data-theme="dark"] {
    --bg: #1A1310;
    --surface: #241A15;
    --ink: #F1E7DE;
    --ink-soft: #B4A392;
    --border: #38291F;
    --wine: #B23349;
    --wine-deep: #E15A6F;
    --wine-pale: #2E1A1E;
    --amber: #E29A4D;
    --gold: #E6BC64;
  }
  * { box-sizing: border-box; }
  html, body {
    height: 100%;
    margin: 0;
    background: var(--bg);
    font-family: var(--font-body);
    color: var(--ink);
    -webkit-font-smoothing: antialiased;
  }
  html { scroll-padding-top: env(safe-area-inset-top, 0px); }
  body {
    padding-top: env(safe-area-inset-top, 0px);
    padding-bottom: env(safe-area-inset-bottom, 0px);
    display: flex;
    justify-content: center;
  }
  .device {
    width: 100%;
    max-width: 420px;
    min-height: 100dvh;
    background: var(--bg);
    position: relative;
    display: flex;
    flex-direction: column;
    overflow-x: hidden;
  }

  /* ---- Age gate ---- */
  .agegate {
    position: fixed; inset: 0;
    background: var(--wine-deep);
    z-index: 100;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 24px;
  }
  .agegate-card {
    background: var(--surface);
    border-radius: var(--radius-l);
    padding: 34px 26px;
    max-width: 360px;
    width: 100%;
    text-align: center;
  }
  .agegate-card .mark {
    font-size: 40px;
    margin-bottom: 12px;
  }
  .agegate-card h1 {
    font-family: var(--font-display);
    font-size: 22px;
    margin: 0 0 10px;
    font-weight: 700;
  }
  .agegate-card p {
    color: var(--ink-soft);
    font-size: 13.5px;
    line-height: 1.6;
    margin: 0 0 22px;
  }
  .agegate-btns { display: flex; gap: 10px; }
  .agegate-btns button {
    flex: 1;
    padding: 13px;
    border-radius: var(--radius-m);
    font-weight: 700;
    font-size: 13.5px;
    border: none;
    cursor: pointer;
    font-family: var(--font-body);
  }
  .btn-yes { background: var(--wine); color: #fff; }
  .btn-no { background: var(--bg); color: var(--ink-soft); border: 1px solid var(--border) !important; }
  .agegate-fine { font-size: 10.5px; color: var(--ink-soft); margin-top: 16px; opacity: .7; }
  .blocked {
    text-align: center;
    padding: 20px 4px 4px;
  }
  .blocked .ic { font-size: 34px; margin-bottom: 10px; }
  .blocked h2 { font-family: var(--font-display); font-size: 18px; margin: 0 0 8px; }
  .blocked p { font-size: 13px; color: var(--ink-soft); }

  /* ---- Header ---- */
  header.top {
    position: sticky;
    top: env(safe-area-inset-top, 0px);
    z-index: 30;
    background: var(--surface);
    border-bottom: 1px solid var(--border);
    padding: 14px 16px 10px;
  }
  .loc-row { display: flex; align-items: center; justify-content: space-between; gap: 10px; }
  .loc { display: flex; flex-direction: column; gap: 1px; min-width: 0; }
  .loc-label { font-family: var(--font-display); font-weight: 700; font-size: 15px; display: flex; align-items: center; gap: 6px; }
  .status-dot { width: 7px; height: 7px; border-radius: 50%; flex: none; }
  .status-dot.open { background: #3C9A5F; }
  .status-dot.closed { background: var(--danger); }
  .loc-addr { font-size: 12.5px; color: var(--ink-soft); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 230px; }
  .profile-btn { width: 36px; height: 36px; border-radius: 50%; background: var(--wine-pale); border: none; display: flex; align-items: center; justify-content: center; color: var(--wine); flex: none; cursor: pointer; }
  .search-row { margin-top: 12px; display: flex; align-items: center; gap: 10px; background: var(--bg); border: 1px solid var(--border); border-radius: var(--radius-m); padding: 10px 12px; }
  .search-row input { border: none; background: transparent; outline: none; font-size: 14.5px; color: var(--ink); width: 100%; font-family: var(--font-body); }
  .search-row input::placeholder { color: var(--ink-soft); }

  /* ---- Hours strip ---- */
  .hours-strip {
    margin: 14px 16px 4px;
    border-radius: var(--radius-l);
    padding: 16px 18px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    position: relative;
    overflow: hidden;
    color: #fff;
  }
  .hours-strip.open { background: linear-gradient(135deg, var(--wine-deep), var(--wine)); }
  .hours-strip.closed { background: linear-gradient(135deg, #3A3A3A, #55504B); }
  .hours-strip::after { content: ""; position: absolute; right: -30px; top: -30px; width: 120px; height: 120px; background: rgba(255,255,255,0.07); border-radius: 50%; }
  .hours-title { font-family: var(--font-display); font-weight: 700; font-size: 16.5px; }
  .hours-sub { font-size: 12px; opacity: 0.85; margin-top: 3px; }
  .hours-badge { background: rgba(255,255,255,0.16); border-radius: 999px; padding: 7px 13px; font-size: 12px; font-weight: 600; }

  /* ---- Category chips ---- */
  .cat-scroll { display: flex; gap: 10px; padding: 16px 16px 6px; overflow-x: auto; scrollbar-width: none; }
  .cat-scroll::-webkit-scrollbar { display: none; }
  .cat-chip { flex: none; display: flex; flex-direction: column; align-items: center; gap: 6px; cursor: pointer; width: 68px; }
  .cat-chip .ic { width: 56px; height: 56px; border-radius: 18px; background: var(--surface); border: 1.5px solid var(--border); display: flex; align-items: center; justify-content: center; font-size: 26px; transition: border-color .15s, background .15s; }
  .cat-chip.active .ic { border-color: var(--wine); background: var(--wine-pale); }
  .cat-chip span { font-size: 11px; text-align: center; color: var(--ink-soft); font-weight: 600; line-height: 1.2; }
  .cat-chip.active span { color: var(--wine); }

  .section-head { display: flex; align-items: baseline; justify-content: space-between; padding: 18px 16px 10px; }
  .section-head h2 { font-family: var(--font-display); font-size: 17px; margin: 0; font-weight: 700; }
  .section-head .count { font-size: 12px; color: var(--ink-soft); }

  .grid { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; padding: 0 16px 18px; }
  .card { background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius-m); padding: 12px; display: flex; flex-direction: column; gap: 8px; position: relative; }
  .card .badge { position: absolute; top: 10px; left: 10px; background: var(--gold); color: #3A2A00; font-size: 10px; font-weight: 700; padding: 3px 7px; border-radius: 6px; }
  .card .abv { position: absolute; top: 10px; right: 10px; font-size: 10px; font-weight: 700; color: var(--ink-soft); background: var(--bg); padding: 3px 7px; border-radius: 6px; }
  .card .thumb { height: 72px; display: flex; align-items: center; justify-content: center; font-size: 40px; }
  .card .unit { font-size: 11.5px; color: var(--ink-soft); font-weight: 500; }
  .card .name { font-size: 13.5px; font-weight: 600; line-height: 1.25; min-height: 34px; }
  .card .bottom-row { display: flex; align-items: center; justify-content: space-between; margin-top: 2px; }
  .card .price { font-family: var(--font-display); font-weight: 700; font-size: 14.5px; }
  .card .price .mrp { font-family: var(--font-body); font-weight: 500; font-size: 11px; color: var(--ink-soft); text-decoration: line-through; margin-left: 4px; }
  .add-btn { background: var(--surface); border: 1.5px solid var(--wine); color: var(--wine); font-weight: 700; font-size: 12.5px; border-radius: var(--radius-s); padding: 6px 14px; cursor: pointer; }
  .add-btn:disabled { opacity: .4; cursor: not-allowed; border-color: var(--ink-soft); color: var(--ink-soft); }
  .qty-stepper { display: flex; align-items: center; background: var(--wine); border-radius: var(--radius-s); overflow: hidden; }
  .qty-stepper button { width: 26px; height: 26px; border: none; background: transparent; color: #fff; font-size: 15px; font-weight: 700; cursor: pointer; display: flex; align-items: center; justify-content: center; }
  .qty-stepper .n { color: #fff; font-weight: 700; font-size: 12.5px; min-width: 18px; text-align: center; }

  .cart-bar { position: sticky; bottom: calc(64px + env(safe-area-inset-bottom, 0px)); left: 0; right: 0; margin: 0 16px 10px; background: var(--wine-deep); color: #fff; border-radius: var(--radius-m); padding: 12px 16px; display: flex; align-items: center; justify-content: space-between; cursor: pointer; box-shadow: 0 8px 22px rgba(74, 13, 24, 0.35); transition: transform .2s ease; z-index: 25; }
  .cart-bar.hidden { transform: translateY(120px); }
  .cart-bar .left { display: flex; flex-direction: column; }
  .cart-bar .items { font-size: 11.5px; opacity: 0.85; }
  .cart-bar .total { font-family: var(--font-display); font-weight: 700; font-size: 15px; }
  .cart-bar .right { display: flex; align-items: center; gap: 6px; font-weight: 700; font-size: 13.5px; }

  nav.bottom { position: sticky; bottom: 0; background: var(--surface); border-top: 1px solid var(--border); display: flex; padding: 8px 6px calc(8px + env(safe-area-inset-bottom, 0px)); z-index: 26; }
  nav.bottom button { flex: 1; background: none; border: none; display: flex; flex-direction: column; align-items: center; gap: 3px; color: var(--ink-soft); font-size: 10.5px; font-weight: 600; cursor: pointer; padding: 4px 0; }
  nav.bottom button.active { color: var(--wine); }

  .overlay { position: fixed; inset: 0; background: rgba(20, 10, 8, 0.5); opacity: 0; pointer-events: none; transition: opacity .2s ease; z-index: 40; display: flex; justify-content: center; }
  .overlay.show { opacity: 1; pointer-events: auto; }
  .drawer { width: 100%; max-width: 420px; background: var(--surface); position: absolute; bottom: 0; left: 50%; transform: translate(-50%, 100%); transition: transform .25s ease; border-radius: 22px 22px 0 0; max-height: 86vh; display: flex; flex-direction: column; padding-bottom: env(safe-area-inset-bottom, 0px); }
  .overlay.show .drawer { transform: translate(-50%, 0); }
  .drawer-head { padding: 16px 18px 10px; display: flex; align-items: center; justify-content: space-between; border-bottom: 1px solid var(--border); }
  .drawer-head h3 { font-family: var(--font-display); margin: 0; font-size: 17px; }
  .drawer-head button { background: var(--bg); border: none; width: 30px; height: 30px; border-radius: 50%; cursor: pointer; color: var(--ink-soft); font-size: 15px; }
  .cart-list { overflow-y: auto; padding: 6px 18px; flex: 1; }
  .cart-row { display: flex; align-items: center; gap: 12px; padding: 12px 0; border-bottom: 1px solid var(--border); }
  .cart-row .thumb { font-size: 28px; width: 40px; text-align: center; }
  .cart-row .info { flex: 1; min-width: 0; }
  .cart-row .info .name { font-size: 13.5px; font-weight: 600; }
  .cart-row .info .unit { font-size: 11px; color: var(--ink-soft); }
  .cart-row .price { font-size: 13px; font-weight: 700; font-family: var(--font-display); min-width: 52px; text-align: right; }
  .empty-cart { text-align: center; padding: 50px 20px; color: var(--ink-soft); font-size: 13.5px; }
  .empty-cart .ic { font-size: 40px; margin-bottom: 10px; }
  .drawer-foot { padding: 14px 18px; border-top: 1px solid var(--border); }
  .id-notice { background: var(--wine-pale); color: var(--wine-deep); font-size: 11.5px; border-radius: var(--radius-s); padding: 9px 11px; margin-bottom: 10px; line-height: 1.4; }
  .bill-row { display: flex; justify-content: space-between; font-size: 13px; color: var(--ink-soft); margin-bottom: 6px; }
  .bill-row.total { color: var(--ink); font-weight: 700; font-size: 14.5px; margin-top: 8px; padding-top: 8px; border-top: 1px dashed var(--border); }
  .checkout-btn { width: 100%; margin-top: 12px; background: var(--amber); color: #fff; border: none; border-radius: var(--radius-m); padding: 14px; font-family: var(--font-display); font-weight: 700; font-size: 14.5px; cursor: pointer; }
  .checkout-btn:disabled { opacity: 0.5; cursor: not-allowed; }

  .success { display: flex; flex-direction: column; align-items: center; text-align: center; padding: 50px 30px; }
  .success .circle { width: 70px; height: 70px; border-radius: 50%; background: var(--wine-pale); color: var(--wine); display: flex; align-items: center; justify-content: center; font-size: 32px; margin-bottom: 16px; }
  .success h3 { font-family: var(--font-display); margin: 0 0 6px; font-size: 18px; }
  .success p { color: var(--ink-soft); font-size: 13px; margin: 0 0 4px; line-height: 1.5; }
  .success .track-btn { margin-top: 20px; background: var(--wine-deep); color: #fff; border: none; border-radius: var(--radius-m); padding: 12px 26px; font-weight: 700; font-size: 13.5px; cursor: pointer; }

  .toast { position: fixed; bottom: 90px; left: 50%; transform: translate(-50%, 20px); background: var(--ink); color: var(--bg); padding: 9px 18px; border-radius: 999px; font-size: 12.5px; font-weight: 600; opacity: 0; pointer-events: none; transition: all .2s ease; z-index: 60; }
  .toast.show { opacity: 1; transform: translate(-50%, 0); }

  ::selection { background: var(--gold); color: #1a1a1a; }
</style>
</head>
<body>
<div class="device" id="app"></div>
<div class="toast" id="toast"></div>

<script>
(function(){
  "use strict";

  // Delivery hours are configurable per-region — most Indian states restrict
  // alcohol delivery to a legal window rather than allowing 24/7 sale.
  var DELIVERY_HOURS = { openHour: 11, closeHour: 23 }; // 11:00–23:00 local time, adjust per state excise rules

  var CATS = [
    {id:'beer', label:'Beer', icon:'🍺'},
    {id:'whisky', label:'Whisky', icon:'🥃'},
    {id:'vodka', label:'Vodka', icon:'🍸'},
    {id:'rum', label:'Rum', icon:'🥂'},
    {id:'wine', label:'Wine', icon:'🍷'},
    {id:'gin', label:'Gin', icon:'🍹'},
    {id:'mixers', label:'Mixers', icon:'🧃'},
    {id:'snacks', label:'Chakhna', icon:'🥜'}
  ];

  var PRODUCTS = [
    {id:'b1', cat:'beer', name:'Kingfisher Premium', unit:'650 ml', price:150, mrp:160, icon:'🍺', abv:'4.8%', badge:'CHILLED'},
    {id:'b2', cat:'beer', name:'Bira White', unit:'330 ml x 4', price:480, mrp:520, icon:'🍺', abv:'4.5%'},
    {id:'b3', cat:'beer', name:'Budweiser', unit:'500 ml', price:170, mrp:180, icon:'🍺', abv:'5%'},
    {id:'w1', cat:'whisky', name:'Blenders Pride', unit:'750 ml', price:950, mrp:1000, icon:'🥃', abv:'42.8%'},
    {id:'w2', cat:'whisky', name:'Royal Stag', unit:'750 ml', price:620, mrp:650, icon:'🥃', abv:'42.8%'},
    {id:'w3', cat:'whisky', name:'Johnnie Walker Black', unit:'750 ml', price:3200, mrp:3400, icon:'🥃', abv:'40%', badge:'PREMIUM'},
    {id:'v1', cat:'vodka', name:'Absolut Blue', unit:'750 ml', price:1400, mrp:1500, icon:'🍸', abv:'40%'},
    {id:'v2', cat:'vodka', name:'Smirnoff Red', unit:'750 ml', price:750, mrp:800, icon:'🍸', abv:'37.5%'},
    {id:'r1', cat:'rum', name:'Old Monk', unit:'750 ml', price:520, mrp:550, icon:'🥂', abv:'42.8%'},
    {id:'r2', cat:'rum', name:'Bacardi White', unit:'750 ml', price:900, mrp:950, icon:'🥂', abv:'37.5%'},
    {id:'wn1', cat:'wine', name:'Sula Shiraz', unit:'750 ml', price:850, mrp:900, icon:'🍷', abv:'13.5%'},
    {id:'wn2', cat:'wine', name:'Jacob\'s Creek', unit:'750 ml', price:1150, mrp:1200, icon:'🍷', abv:'13%'},
    {id:'g1', cat:'gin', name:'Hendrick\'s Gin', unit:'750 ml', price:3600, mrp:3800, icon:'🍹', abv:'41.4%', badge:'PREMIUM'},
    {id:'g2', cat:'gin', name:'Greater Than Gin', unit:'750 ml', price:1400, mrp:1500, icon:'🍹', abv:'42.8%'},
    {id:'m1', cat:'mixers', name:'Schweppes Soda Club', unit:'750 ml', price:60, mrp:65, icon:'🧃', abv:'0%'},
    {id:'m2', cat:'mixers', name:'Tonic Water', unit:'300 ml', price:45, mrp:50, icon:'🧃', abv:'0%'},
    {id:'m3', cat:'mixers', name:'Coca-Cola', unit:'750 ml', price:45, mrp:48, icon:'🥤', abv:'0%'},
    {id:'s1', cat:'snacks', name:'Roasted Peanuts', unit:'200 g', price:60, mrp:65, icon:'🥜', abv:'0%'},
    {id:'s2', cat:'snacks', name:'Spicy Chakhna Mix', unit:'150 g', price:90, mrp:99, icon:'🌶️', abv:'0%'},
    {id:'s3', cat:'snacks', name:'Nachos & Salsa', unit:'180 g', price:130, mrp:140, icon:'🌽', abv:'0%'}
  ];

  var state = { cat:'beer', query:'', cart:{}, tab:'home', drawerOpen:false, checkoutStep:'cart', ageVerified:false, blocked:false };

  function el(tag, attrs, children){
    var e = document.createElement(tag);
    if (attrs) for (var k in attrs) {
      if (k === 'class') e.className = attrs[k];
      else if (k === 'html') e.innerHTML = attrs[k];
      else if (k.indexOf('on') === 0) e.addEventListener(k.slice(2), attrs[k]);
      else e.setAttribute(k, attrs[k]);
    }
    if (children) children.forEach(function(c){ if (c) e.appendChild(c); });
    return e;
  }
  function money(n){ return '₹' + n; }

  function isStoreOpen(){
    var h = new Date().getHours();
    return h >= DELIVERY_HOURS.openHour && h < DELIVERY_HOURS.closeHour;
  }

  function cartCount(){ var n=0; for (var id in state.cart) n += state.cart[id]; return n; }
  function cartTotal(){ var t=0; for (var id in state.cart){ var p=PRODUCTS.filter(function(x){return x.id===id;})[0]; if(p) t+=p.price*state.cart[id]; } return t; }
  function mrpTotal(){ var t=0; for (var id in state.cart){ var p=PRODUCTS.filter(function(x){return x.id===id;})[0]; if(p) t+=p.mrp*state.cart[id]; } return t; }

  function showToast(msg){
    var t = document.getElementById('toast');
    t.textContent = msg;
    t.classList.add('show');
    clearTimeout(showToast._h);
    showToast._h = setTimeout(function(){ t.classList.remove('show'); }, 1400);
  }

  function addQty(id, delta){
    if (!isStoreOpen()) { showToast('Store is closed right now'); return; }
    var cur = state.cart[id] || 0;
    var next = cur + delta;
    if (next <= 0) delete state.cart[id]; else state.cart[id] = next;
    persist();
    render();
  }
  function persist(){
    try { window.localStorage.setItem('drinkit_cart', JSON.stringify(state.cart)); } catch(e) {}
  }
  function restore(){
    try {
      var raw = window.localStorage.getItem('drinkit_cart');
      if (raw) state.cart = JSON.parse(raw);
      var age = window.localStorage.getItem('drinkit_age_ok');
      if (age === '1') state.ageVerified = true;
    } catch(e) {}
  }

  function productCard(p){
    var qty = state.cart[p.id] || 0;
    var open = isStoreOpen();
    var card = el('div', {class:'card'});
    if (p.badge) card.appendChild(el('div', {class:'badge', html:p.badge}));
    if (p.abv && p.abv !== '0%') card.appendChild(el('div', {class:'abv', html:p.abv}));
    card.appendChild(el('div', {class:'thumb', html:p.icon}));
    card.appendChild(el('div', {class:'unit', html:p.unit}));
    card.appendChild(el('div', {class:'name', html:p.name}));
    var priceHtml = money(p.price) + (p.mrp > p.price ? '<span class="mrp">'+money(p.mrp)+'</span>' : '');
    var bottom = el('div', {class:'bottom-row'});
    bottom.appendChild(el('div', {class:'price', html:priceHtml}));
    if (qty === 0) {
      bottom.appendChild(el('button', {class:'add-btn', disabled: open ? null : 'disabled', onclick:function(){ addQty(p.id, 1); if (open) showToast(p.name + ' added'); }}, [document.createTextNode(open ? 'ADD' : 'CLOSED')]));
    } else {
      var stepper = el('div', {class:'qty-stepper'});
      stepper.appendChild(el('button', {onclick:function(){ addQty(p.id, -1); }}, [document.createTextNode('−')]));
      stepper.appendChild(el('div', {class:'n', html:String(qty)}));
      stepper.appendChild(el('button', {onclick:function(){ addQty(p.id, 1); }}, [document.createTextNode('+')]));
      bottom.appendChild(stepper);
    }
    card.appendChild(bottom);
    return card;
  }

  function renderHome(root){
    var open = isStoreOpen();
    var header = el('header', {class:'top'});
    var locRow = el('div', {class:'loc-row'});
    var loc = el('div', {class:'loc'});
    loc.appendChild(el('div', {class:'loc-label', html:'<span class="status-dot '+(open?'open':'closed')+'"></span> Drinkit'}));
    loc.appendChild(el('div', {class:'loc-addr', html:'Vijay Nagar, Indore, Madhya Pradesh'}));
    locRow.appendChild(loc);
    locRow.appendChild(el('button', {class:'profile-btn', html:'👤', onclick:function(){ setTab('account'); }}));
    header.appendChild(locRow);
    var searchRow = el('div', {class:'search-row'});
    searchRow.appendChild(el('span', {html:'🔍'}));
    var input = el('input', {placeholder:'Search beer, whisky, vodka...', value:state.query});
    input.addEventListener('input', function(e){ state.query = e.target.value; renderList(); });
    searchRow.appendChild(input);
    header.appendChild(searchRow);
    root.appendChild(header);

    var strip = el('div', {class:'hours-strip ' + (open ? 'open' : 'closed')});
    var stripLeft = el('div');
    stripLeft.appendChild(el('div', {class:'hours-title', html: open ? 'Delivering now' : 'Store closed'}));
    stripLeft.appendChild(el('div', {class:'hours-sub', html: 'Sale hours: ' + DELIVERY_HOURS.openHour + ':00 – ' + DELIVERY_HOURS.closeHour + ':00, per local excise rules'}));
    strip.appendChild(stripLeft);
    strip.appendChild(el('div', {class:'hours-badge', html: open ? '🍾 Open' : '🔒 Reopens ' + DELIVERY_HOURS.openHour + ':00'}));
    root.appendChild(strip);

    var chipRow = el('div', {class:'cat-scroll'});
    CATS.forEach(function(c){
      var chip = el('div', {class:'cat-chip' + (state.cat===c.id ? ' active' : ''), onclick:function(){ state.cat = c.id; render(); }});
      chip.appendChild(el('div', {class:'ic', html:c.icon}));
      chip.appendChild(el('span', {html:c.label}));
      chipRow.appendChild(chip);
    });
    root.appendChild(chipRow);

    var listWrap = el('div', {id:'list-wrap'});
    root.appendChild(listWrap);
    renderListInto(listWrap);
    root.appendChild(cartBar());
  }

  function renderListInto(wrap){
    wrap.innerHTML = '';
    var catObj = CATS.filter(function(c){return c.id===state.cat;})[0];
    var items = PRODUCTS.filter(function(p){
      var matchesCat = p.cat === state.cat;
      var matchesQuery = !state.query || p.name.toLowerCase().indexOf(state.query.toLowerCase()) > -1;
      return state.query ? matchesQuery : matchesCat;
    });
    var head = el('div', {class:'section-head'});
    head.appendChild(el('h2', {html: state.query ? 'Results for "'+state.query+'"' : catObj.label}));
    head.appendChild(el('span', {class:'count', html: items.length + ' items'}));
    wrap.appendChild(head);
    var grid = el('div', {class:'grid'});
    items.forEach(function(p){ grid.appendChild(productCard(p)); });
    if (items.length === 0) wrap.appendChild(el('div', {class:'empty-cart', html:'<div class="ic">🔎</div>No items match your search.'}));
    else wrap.appendChild(grid);
  }
  function renderList(){ var wrap = document.getElementById('list-wrap'); if (wrap) renderListInto(wrap); }

  function cartBar(){
    var n = cartCount();
    var bar = el('div', {class:'cart-bar' + (n===0 ? ' hidden' : ''), onclick:function(){ openDrawer(); }});
    var left = el('div', {class:'left'});
    left.appendChild(el('div', {class:'items', html:n + ' item' + (n===1?'':'s')}));
    left.appendChild(el('div', {class:'total', html: money(cartTotal())}));
    bar.appendChild(left);
    bar.appendChild(el('div', {class:'right', html:'View cart →'}));
    return bar;
  }

  function bottomNav(){
    var nav = el('nav', {class:'bottom'});
    var tabs = [{id:'home', label:'Home', icon:'🏠'},{id:'cats', label:'Categories', icon:'📋'},{id:'cart', label:'Cart', icon:'🛒'},{id:'account', label:'Account', icon:'👤'}];
    tabs.forEach(function(t){
      var btn = el('button', {class: state.tab===t.id ? 'active' : '', onclick:function(){ if (t.id==='cart'){ openDrawer(); return; } setTab(t.id); }});
      btn.appendChild(el('div', {html:t.icon}));
      btn.appendChild(el('div', {html:t.label}));
      nav.appendChild(btn);
    });
    return nav;
  }

  function setTab(id){ state.tab = id; render(); }
  function openDrawer(){ state.drawerOpen = true; state.checkoutStep = 'cart'; render(); }
  function closeDrawer(){ state.drawerOpen = false; render(); }

  function drawerContent(){
    var overlay = el('div', {class:'overlay' + (state.drawerOpen ? ' show' : ''), onclick:function(e){ if (e.target === overlay) closeDrawer(); }});
    var drawer = el('div', {class:'drawer'});

    if (state.checkoutStep === 'success') {
      var s = el('div', {class:'success'});
      s.appendChild(el('div', {class:'circle', html:'✓'}));
      s.appendChild(el('h3', {html:'Order placed!'}));
      s.appendChild(el('p', {html:'Please have a government photo ID ready — our delivery partner must verify your age at the door.'}));
      s.appendChild(el('p', {html:'Arriving within the hour.'}));
      var track = el('button', {class:'track-btn', onclick:function(){ state.cart = {}; persist(); state.checkoutStep='cart'; closeDrawer(); }}, [document.createTextNode('Back to shopping')]);
      s.appendChild(track);
      drawer.appendChild(el('div', {class:'drawer-head'}, [el('h3',{html:'Order confirmed'}), el('button',{html:'✕', onclick:closeDrawer})]));
      drawer.appendChild(s);
      overlay.appendChild(drawer);
      return overlay;
    }

    var head = el('div', {class:'drawer-head'});
    head.appendChild(el('h3', {html:'Your cart'}));
    head.appendChild(el('button', {html:'✕', onclick:closeDrawer}));
    drawer.appendChild(head);

    var ids = Object.keys(state.cart);
    var list = el('div', {class:'cart-list'});
    if (ids.length === 0) {
      list.appendChild(el('div', {class:'empty-cart', html:'<div class="ic">🛒</div>Your cart is empty.'}));
    } else {
      ids.forEach(function(id){
        var p = PRODUCTS.filter(function(x){return x.id===id;})[0];
        if (!p) return;
        var qty = state.cart[id];
        var row = el('div', {class:'cart-row'});
        row.appendChild(el('div', {class:'thumb', html:p.icon}));
        var info = el('div', {class:'info'});
        info.appendChild(el('div', {class:'name', html:p.name}));
        info.appendChild(el('div', {class:'unit', html:p.unit}));
        var stepper = el('div', {class:'qty-stepper', style:'margin-top:6px;'});
        stepper.appendChild(el('button', {onclick:function(){ addQty(id, -1); render(); }}, [document.createTextNode('−')]));
        stepper.appendChild(el('div', {class:'n', html:String(qty)}));
        stepper.appendChild(el('button', {onclick:function(){ addQty(id, 1); render(); }}, [document.createTextNode('+')]));
        info.appendChild(stepper);
        row.appendChild(info);
        row.appendChild(el('div', {class:'price', html: money(p.price * qty)}));
        list.appendChild(row);
      });
    }
    drawer.appendChild(list);

    var foot = el('div', {class:'drawer-foot'});
    foot.appendChild(el('div', {class:'id-notice', html:'🪪 Valid government photo ID required at delivery. We only deliver within legal sale hours.'}));
    if (ids.length > 0) {
      var mrp = mrpTotal(), total = cartTotal(), savings = mrp - total;
      foot.appendChild(el('div', {class:'bill-row'}, [el('span',{html:'Item total'}), el('span',{html:money(total)})]));
      if (savings > 0) foot.appendChild(el('div', {class:'bill-row'}, [el('span',{html:'Savings'}), el('span',{html:'−'+money(savings)})]));
      foot.appendChild(el('div', {class:'bill-row'}, [el('span',{html:'Delivery fee'}), el('span',{html: total >= 999 ? 'FREE' : money(40)})]));
      var grand = total + (total >= 999 ? 0 : 40);
      foot.appendChild(el('div', {class:'bill-row total'}, [el('span',{html:'To pay'}), el('span',{html:money(grand)})]));
      var open = isStoreOpen();
      var btn = el('button', {class:'checkout-btn', disabled: open ? null : 'disabled', onclick:function(){ if(!open) return; state.checkoutStep = 'success'; render(); }}, [document.createTextNode(open ? ('Place order · ' + money(grand)) : 'Store closed')]);
      foot.appendChild(btn);
    }
    drawer.appendChild(foot);
    overlay.appendChild(drawer);
    return overlay;
  }

  function renderAgeGate(){
    var gate = el('div', {class:'agegate'});
    var card = el('div', {class:'agegate-card'});
    if (state.blocked) {
      var b = el('div', {class:'blocked'});
      b.appendChild(el('div', {class:'ic', html:'🚫'}));
      b.appendChild(el('h2', {html:'Access restricted'}));
      b.appendChild(el('p', {html:'You must meet the legal drinking age in your state to use this app. Come back once you do.'}));
      card.appendChild(b);
    } else {
      card.appendChild(el('div', {class:'mark', html:'🍷'}));
      card.appendChild(el('h1', {html:'Are you 21 or older?'}));
      card.appendChild(el('p', {html:'Drinkit sells alcohol and is restricted to adults who meet the legal drinking age in their state. We verify ID again at delivery.'}));
      var btns = el('div', {class:'agegate-btns'});
      btns.appendChild(el('button', {class:'btn-no', onclick:function(){ state.blocked = true; render(); }}, [document.createTextNode('No')]));
      btns.appendChild(el('button', {class:'btn-yes', onclick:function(){ state.ageVerified = true; try{ window.localStorage.setItem('drinkit_age_ok','1'); }catch(e){} render(); }}, [document.createTextNode('Yes, I am')]));
      card.appendChild(btns);
      card.appendChild(el('div', {class:'agegate-fine', html:'Drink responsibly. Alcohol delivery is subject to your state\'s excise laws and sale hours.'}));
    }
    gate.appendChild(card);
    return gate;
  }

  function render(){
    var root = document.getElementById('app');
    root.innerHTML = '';
    if (!state.ageVerified) {
      root.appendChild(renderAgeGate());
      return;
    }
    if (state.tab === 'home' || state.tab === 'cats') {
      renderHome(root);
    } else if (state.tab === 'account') {
      var wrap = el('div', {style:'padding:24px 20px;'});
      wrap.appendChild(el('h2', {style:'font-family:var(--font-display); font-size:18px; margin-top:12px;', html:'Account'}));
      wrap.appendChild(el('p', {style:'color:var(--ink-soft); font-size:13.5px; line-height:1.6;', html:'This is a UI prototype — real sign-in would require ID verification, order history and saved addresses would live here.'}));
      root.appendChild(wrap);
      root.appendChild(cartBar());
    }
    root.appendChild(bottomNav());
    var oldOverlay = document.getElementById('cart-overlay');
    if (oldOverlay) oldOverlay.remove();
    var overlay = drawerContent();
    overlay.id = 'cart-overlay';
    document.body.appendChild(overlay);
  }

  restore();
  render();
})();
</script>
</body>
</html>
